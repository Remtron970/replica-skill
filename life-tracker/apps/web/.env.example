# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe to ship in a web app (access is protected by Row Level
# Security). NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: show "Continue with Google" once Google sign-in is configured (Phase 4).
VITE_AUTH_GOOGLE=0
